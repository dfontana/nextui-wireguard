#!/bin/sh
BIN_DIR="$(dirname "$0")"
PAK_DIR="$(dirname "$BIN_DIR")"
PAK_NAME="$(basename "$PAK_DIR")"
PAK_NAME="${PAK_NAME%.*}"
set -x

. "$PAK_DIR/bin/lib/common.sh"
init_logging "$PAK_NAME.on-boot.txt"

echo "$0" "$@"
cd "$PAK_DIR" || exit 1
init_path

. "$PAK_DIR/bin/lib/wireguard.sh"

WG_CONF_STORED="$USERDATA_PATH/$PAK_NAME/wg0.conf"

main() {
    if is_wireguard_up; then
        echo "WireGuard already running, skipping boot start."
        return 0
    fi

    if [ ! -f "$WG_CONF_STORED" ]; then
        echo "No wg0.conf found at $WG_CONF_STORED, skipping boot start."
        return 0
    fi

    wireguard_up "$WG_CONF_STORED"
}

main "$@"
